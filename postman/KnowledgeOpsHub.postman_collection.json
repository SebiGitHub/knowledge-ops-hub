{
  "info": {
    "_postman_id": "b7d5b2c9-4a3b-4b3c-a6d6-0f28b6f77b1a",
    "name": "KnowledgeOpsHub (Local) — CP7 Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth — Login (sets token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@local.com\",\n  \"password\": \"Password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('login returns token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Jobs — Run inbox (limit=1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/jobs/inbox/run?limit=1",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "inbox", "run"],
          "query": [{ "key": "limit", "value": "1" }]
        }
      }
    },
    {
      "name": "RAG — Ask (with sources)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/ask", "host": ["{{baseUrl}}"], "path": ["ask"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Resume el documento indexado en 5 puntos y cita las fuentes con [1], [2].\"\n}"
        }
      }
    },
    {
      "name": "Jobs — Save digest",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/jobs/digest/save", "host": ["{{baseUrl}}"], "path": ["jobs", "digest", "save"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"# Digest\\n\\n- Ejemplo de digest generado desde Postman.\\n\"\n}"
        }
      }
    }
  ]
}
